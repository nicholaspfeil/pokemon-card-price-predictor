        "feature_names = [\"7d momentum\", \"30d trend\", \"60d trend\", \"volatility\",\n",
        "                 \"price level\", \"recent volume\", \"volume trend\",\n",
        "                 \"acceleration\", \"rarity\", \"maturity\", \"price position\", \"long drift\"]\n",
        "\n",
        "def evaluate(model, label):\n",
        "    model.fit(X_train, y_train)\n",
        "    preds = model.predict(X_test)\n",
        "    mae = mean_absolute_error(y_test, preds)\n",
        "    r2 = r2_score(y_test, preds)\n",
        "    baseline = mean_absolute_error(y_test, np.zeros_like(y_test))\n",

        "        print(f\"  Beats baseline by {baseline - mae:.1f} pts\")\n",
        "    else:\n",
        "        print(f\"  Does NOT beat baseline\")\n",
        "    return model, r2\n",
        "\n",
        "# Model A: GradientBoosting with the new features\n",

        "    vol_trend = pct_change(avg_older_vol + 1, avg_recent_vol + 1)\n",
        "    acceleration = pct_change(p7, current) - pct_change(p30, p7)\n",
        "    hist_min, hist_max = min(wp), max(wp)\n",

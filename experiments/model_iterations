        "# ===========================================================================\n",
        "# POKEMON PREDICTOR — Price Forecasting Model\n",
        "# Predicts a card's % price change ~60 days into the future, from its\n",
        "# recent price behavior. Uses classical ML (scikit-learn), trained from\n",
        "# scratch on your own data. Validated with an honest backtest.\n",
        "# ===========================================================================\n",
        "\n",
        "import json\n",
        "import numpy as np\n",
        "from sklearn.ensemble import GradientBoostingRegressor\n",
        "from sklearn.metrics import mean_absolute_error, r2_score\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# CONFIG\n",
        "# ---------------------------------------------------------------------------\n",
        "HORIZON_DAYS = 60         # how far into the future we predict (~2 months)\n",
        "MIN_HISTORY = 150         # only use cards with at least this many days\n",
        "MIN_PRICE = 1.00          # ignore near-worthless cards (code cards, etc.)\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# STEP 1: Load and clean the data\n",
        "# ---------------------------------------------------------------------------\n",
        "with open(\"price_history_dataset.json\") as f:\n",
        "    raw = json.load(f)\n",
        "\n",
        "def clean_series(card):\n",
        "    \"\"\"Return a clean, date-sorted list of prices for a card, or None if\n",
        "    it doesn't qualify (too short, or too cheap to be meaningful).\"\"\"\n",
        "    history = [p for p in card[\"price_history\"] if p[\"price\"] is not None]\n",
        "    history.sort(key=lambda p: p[\"date\"])\n",
        "    if len(history) < MIN_HISTORY:\n",
        "        return None\n",
        "    prices = [p[\"price\"] for p in history]\n",
        "    # skip cards whose typical price is below our floor\n",
        "    if np.median(prices) < MIN_PRICE:\n",
        "        return None\n",
        "    return prices\n",
        "\n",
        "cards = []\n",
        "for card in raw:\n",
        "    prices = clean_series(card)\n",
        "    if prices is not None:\n",
        "        cards.append({\"name\": card[\"name\"], \"set\": card[\"setName\"],\n",
        "                      \"rarity\": card.get(\"rarity\"), \"prices\": prices})\n",
        "\n",
        "print(f\"Usable cards after cleaning: {len(cards)}\")\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# STEP 2: Feature engineering\n",
        "# For each card we build features from the price history UP TO a cutoff\n",
        "# point, and the \"answer\" (label) is the % change from that cutoff to\n",
        "# HORIZON_DAYS later. This is the heart of the model.\n",
        "# ---------------------------------------------------------------------------\n",
        "\n",
        "def pct_change(a, b):\n",
        "    \"\"\"Percent change from a to b.\"\"\"\n",
        "    if a == 0:\n",
        "        return 0.0\n",
        "    return (b - a) / a * 100\n",
        "\n",
        "def build_features(prices, cutoff):\n",
        "    \"\"\"Given a price series and a cutoff index, compute features describing\n",
        "    the card's behavior in the window BEFORE the cutoff. The model uses these\n",
        "    to predict what happens AFTER the cutoff.\"\"\"\n",
        "    window = prices[:cutoff]\n",
        "    if len(window) < 60:\n",
        "        return None\n",
        "\n",
        "    current = window[-1]\n",
        "    price_7d_ago = window[-7]\n",
        "    price_30d_ago = window[-30]\n",
        "    price_60d_ago = window[-60]\n",
        "\n",
        "    recent_prices = window[-30:]\n",
        "    volatility = np.std(recent_prices) / (np.mean(recent_prices) + 1e-9)\n",
        "\n",
        "    return [\n",
        "        pct_change(price_7d_ago, current),    # 7-day momentum\n",
        "        pct_change(price_30d_ago, current),   # 30-day trend\n",
        "        pct_change(price_60d_ago, current),   # 60-day trend\n",
        "        volatility * 100,                     # how bouncy the price is\n",
        "        np.log(current + 1),                  # price level (log-scaled)\n",
        "    ]\n",
        "\n",
        "# Build the training table. For each card, we pick a cutoff that leaves\n",
        "# room for a HORIZON_DAYS-ahead label.\n",
        "X, y = [], []\n",
        "for card in cards:\n",
        "    prices = card[\"prices\"]\n",
        "    # cutoff must leave HORIZON_DAYS of future prices for the label\n",
        "    cutoff = len(prices) - HORIZON_DAYS\n",
        "    if cutoff < 60:\n",
        "        continue\n",
        "\n",
        "    features = build_features(prices, cutoff)\n",
        "    if features is None:\n",
        "        continue\n",
        "\n",
        "    price_at_cutoff = prices[cutoff - 1]\n",
        "    price_future = prices[cutoff - 1 + HORIZON_DAYS]\n",
        "    label = pct_change(price_at_cutoff, price_future)\n",
        "\n",
        "    X.append(features)\n",
        "    y.append(label)\n",
        "\n",
        "X = np.array(X)\n",
        "y = np.array(y)\n",
        "print(f\"Training examples built: {len(X)}\")\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# STEP 3: The backtest split (temporal validation)\n",
        "# We split cards into train/test. The model learns on one group and is\n",
        "# tested on cards it has NEVER seen — proving it generalizes, not memorizes.\n",
        "# ---------------------------------------------------------------------------\n",
        "split = int(len(X) * 0.8)\n",
        "X_train, X_test = X[:split], X[split:]\n",
        "y_train, y_test = y[:split], y[split:]\n",
        "print(f\"Train: {len(X_train)} | Test: {len(X_test)}\\n\")\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# STEP 4: Train the model (this is the actual \"machine learning\" moment)\n",
        "# ---------------------------------------------------------------------------\n",
        "print(\"Training model...\")\n",
        "model = GradientBoostingRegressor(n_estimators=200, max_depth=3, learning_rate=0.05)\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# STEP 5: Evaluate honestly\n",
        "# ---------------------------------------------------------------------------\n",
        "preds = model.predict(X_test)\n",
        "mae = mean_absolute_error(y_test, preds)\n",
        "r2 = r2_score(y_test, preds)\n",
        "\n",
        "# Baseline for comparison: \"predict no change\" (0%). If our model can't\n",
        "# beat this, it's not learning anything useful. This is a crucial honesty check.\n",
        "baseline_mae = mean_absolute_error(y_test, np.zeros_like(y_test))\n",
        "\n",
        "print(\"\\n=== RESULTS ===\")\n",
        "print(f\"Model average error:    {mae:.1f} percentage points\")\n",
        "print(f\"Baseline (no-change):   {baseline_mae:.1f} percentage points\")\n",
        "print(f\"R^2 score:              {r2:.3f}\")\n",
        "print()\n",
        "if mae < baseline_mae:\n",
        "    print(f\"The model BEATS the naive baseline by {baseline_mae - mae:.1f} points.\")\n",
        "else:\n",
        "    print(\"The model does NOT beat the naive baseline — honest result to report.\")\n",
        "\n",
        "# Which features mattered most?\n",
        "feature_names = [\"7d momentum\", \"30d trend\", \"60d trend\", \"volatility\", \"price level\"]\n",
        "print(\"\\nFeature importance:\")\n",
        "for name, imp in sorted(zip(feature_names, model.feature_importances_), key=lambda x: -x[1]):\n",
        "    print(f\"  {name}: {imp:.3f}\")\n",
        "\n",
        "# Save the trained model\n",
        "import pickle\n",
        "with open(\"price_model.pkl\", \"wb\") as f:\n",
        "    pickle.dump(model, f)\n",
        "print(\"\\nModel saved to price_model.pkl\")"

        "# ===========================================================================\n",
        "# POKEMON PREDICTOR — Price Model v2\n",
        "# Adds volume-based features, rarity, and richer trend features to see if\n",
        "# accuracy improves over v1. Same honest backtest + baseline comparison.\n",
        "# ===========================================================================\n",
        "\n",
        "import json\n",
        "import numpy as np\n",
        "from sklearn.ensemble import GradientBoostingRegressor\n",
        "from sklearn.metrics import mean_absolute_error, r2_score\n",
        "\n",
        "HORIZON_DAYS = 60\n",
        "MIN_HISTORY = 150\n",
        "MIN_PRICE = 1.00\n",
        "\n",
        "with open(\"price_history_dataset.json\") as f:\n",
        "    raw = json.load(f)\n",
        "\n",
        "def clean_series(card):\n",
        "    \"\"\"Return date-sorted (price, volume) points, or None if card doesn't qualify.\"\"\"\n",
        "    history = [p for p in card[\"price_history\"] if p[\"price\"] is not None]\n",
        "    history.sort(key=lambda p: p[\"date\"])\n",
        "    if len(history) < MIN_HISTORY:\n",
        "        return None\n",
        "    prices = [p[\"price\"] for p in history]\n",
        "    if np.median(prices) < MIN_PRICE:\n",
        "        return None\n",
        "    volumes = [(p.get(\"volume\") or 0) for p in history]\n",
        "    return prices, volumes\n",
        "\n",
        "cards = []\n",
        "for card in raw:\n",
        "    result = clean_series(card)\n",
        "    if result is not None:\n",
        "        prices, volumes = result\n",
        "        cards.append({\n",
        "            \"name\": card[\"name\"], \"set\": card[\"setName\"],\n",
        "            \"rarity\": card.get(\"rarity\") or \"Unknown\",\n",
        "            \"prices\": prices, \"volumes\": volumes,\n",
        "        })\n",
        "\n",
        "print(f\"Usable cards after cleaning: {len(cards)}\")\n",
        "\n",
        "# Build a rarity -> number map so the model can use rarity as a feature\n",
        "all_rarities = sorted(set(c[\"rarity\"] for c in cards))\n",
        "rarity_to_num = {r: i for i, r in enumerate(all_rarities)}\n",
        "print(f\"Distinct rarities: {len(all_rarities)}\")\n",
        "\n",
        "def pct_change(a, b):\n",
        "    if a == 0:\n",
        "        return 0.0\n",
        "    return (b - a) / a * 100\n",
        "\n",
        "def build_features(prices, volumes, cutoff, rarity):\n",
        "    window_p = prices[:cutoff]\n",
        "    window_v = volumes[:cutoff]\n",
        "    if len(window_p) < 60:\n",
        "        return None\n",
        "\n",
        "    current = window_p[-1]\n",
        "    p7, p30, p60 = window_p[-7], window_p[-30], window_p[-60]\n",
        "\n",
        "    recent = window_p[-30:]\n",
        "    volatility = np.std(recent) / (np.mean(recent) + 1e-9)\n",
        "\n",
        "    # --- NEW: volume-based features (genuinely new signal) ---\n",
        "    recent_vol = window_v[-30:]\n",
        "    older_vol = window_v[-60:-30]\n",
        "    avg_recent_vol = np.mean(recent_vol) if recent_vol else 0\n",
        "    avg_older_vol = np.mean(older_vol) if older_vol else 0\n",
        "    vol_trend = pct_change(avg_older_vol + 1, avg_recent_vol + 1)  # is trading picking up?\n",
        "\n",
        "    # --- NEW: acceleration (is the trend speeding up or slowing down?) ---\n",
        "    momentum_recent = pct_change(p7, current)\n",
        "    momentum_older = pct_change(p30, p7)\n",
        "    acceleration = momentum_recent - momentum_older\n",
        "\n",
        "    return [\n",
        "        pct_change(p7, current),      # 7d momentum\n",
        "        pct_change(p30, current),     # 30d trend\n",
        "        pct_change(p60, current),     # 60d trend\n",
        "        volatility * 100,             # volatility\n",
        "        np.log(current + 1),          # price level\n",
        "        avg_recent_vol,               # NEW: recent trading volume\n",
        "        vol_trend,                    # NEW: is volume rising?\n",
        "        acceleration,                 # NEW: trend acceleration\n",
        "        rarity_to_num[rarity],        # NEW: rarity\n",
        "    ]\n",
        "\n",
        "X, y = [], []\n",
        "for card in cards:\n",
        "    prices, volumes = card[\"prices\"], card[\"volumes\"]\n",
        "    cutoff = len(prices) - HORIZON_DAYS\n",
        "    if cutoff < 60:\n",
        "        continue\n",
        "    feats = build_features(prices, volumes, cutoff, card[\"rarity\"])\n",
        "    if feats is None:\n",
        "        continue\n",
        "    price_at_cutoff = prices[cutoff - 1]\n",
        "    price_future = prices[cutoff - 1 + HORIZON_DAYS]\n",
        "    y.append(pct_change(price_at_cutoff, price_future))\n",
        "    X.append(feats)\n",
        "\n",
        "X = np.array(X)\n",
        "y = np.array(y)\n",
        "print(f\"Training examples: {len(X)}\")\n",
        "\n",
        "split = int(len(X) * 0.8)\n",
        "X_train, X_test = X[:split], X[split:]\n",
        "y_train, y_test = y[:split], y[split:]\n",
        "print(f\"Train: {len(X_train)} | Test: {len(X_test)}\\n\")\n",
        "\n",
        "print(\"Training v2 model...\")\n",
        "model = GradientBoostingRegressor(n_estimators=300, max_depth=3, learning_rate=0.03)\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "preds = model.predict(X_test)\n",
        "mae = mean_absolute_error(y_test, preds)\n",
        "r2 = r2_score(y_test, preds)\n",
        "baseline_mae = mean_absolute_error(y_test, np.zeros_like(y_test))\n",
        "\n",
        "print(\"\\n=== v2 RESULTS ===\")\n",
        "print(f\"Model average error:  {mae:.1f} percentage points\")\n",
        "print(f\"Baseline (no-change): {baseline_mae:.1f} percentage points\")\n",
        "print(f\"R^2 score:            {r2:.3f}\")\n",
        "print()\n",
        "if mae < baseline_mae:\n",
        "    print(f\"Beats baseline by {baseline_mae - mae:.1f} points.\")\n",
        "else:\n",
        "    print(\"Does NOT beat baseline.\")\n",
        "\n",
        "feature_names = [\"7d momentum\", \"30d trend\", \"60d trend\", \"volatility\",\n",
        "                 \"price level\", \"recent volume\", \"volume trend\",\n",
        "                 \"acceleration\", \"rarity\"]\n",
        "print(\"\\nFeature importance:\")\n",
        "for name, imp in sorted(zip(feature_names, model.feature_importances_), key=lambda x: -x[1]):\n",
        "    print(f\"  {name}: {imp:.3f}\")\n",
        "\n",
        "import pickle\n",
        "with open(\"price_model_v2.pkl\", \"wb\") as f:\n",
        "    pickle.dump(model, f)\n",
        "print(\"\\nModel saved to price_model_v2.pkl\")"
